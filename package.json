{
    "name": "@bitio/opencode-provider-balance",
    "version": "1.0.0",
    "description": "OpenCode TUI plugin that renders a provider balance panel in the sidebar",
    "type": "module",
    "license": "MIT",
    "files": [
        "dist",
        "README.md"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/bitIO/opencode-provider-balance"
    },
    "keywords": [
        "opencode",
        "plugin",
        "balance",
        "provider",
        "tui"
    ],
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        "./tui": {
            "types": "./dist/tui.d.ts",
            "import": "./dist/tui.js"
        }
    },
    "engines": {
        "opencode": ">=1.17"
    },
    "scripts": {
        "prepare": "husky",
        "build": "bun build ./src/tui.tsx --outdir dist --target bun --format esm --external \"@opentui/*\" --external solid-js && tsc --emitDeclarationOnly --declaration --outDir dist",
        "typecheck": "tsc --noEmit",
        "test": "bun test",
        "lint": "biome check .",
        "format": "biome format --write .",
        "lint:fix": "biome check --write .",
        "prepack": "bun run build",
        "release": "node node_modules/semantic-release/bin/semantic-release.js",
        "release:dry": "node node_modules/semantic-release/bin/semantic-release.js --dry-run"
    },
    "peerDependencies": {
        "@opencode-ai/plugin": "^1.17.9",
        "@opentui/core": "^0.4.0",
        "@opentui/keymap": "^0.4.0",
        "@opentui/solid": "^0.4.0",
        "solid-js": "^1.9.0"
    },
    "peerDependenciesMeta": {
        "@opentui/core": {
            "optional": true
        },
        "@opentui/keymap": {
            "optional": true
        },
        "@opentui/solid": {
            "optional": true
        }
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.8",
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@opencode-ai/plugin": "^1.17.9",
        "@opentui/core": "^0.4.0",
        "@opentui/keymap": "^0.4.0",
        "@opentui/solid": "^0.4.0",
        "@semantic-release/changelog": "^7.0.0",
        "@semantic-release/commit-analyzer": "^13.0.1",
        "@semantic-release/git": "^11.0.1",
        "@semantic-release/github": "^12.0.9",
        "@semantic-release/npm": "^13.1.5",
        "@semantic-release/release-notes-generator": "^14.1.1",
        "@types/node": "^22.19.19",
        "husky": "^9.1.7",
        "semantic-release": "^25.0.9",
        "typescript": "^5.9.3"
    }
}
